{
  "name": "eiga-persistent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "node scripts/configure.mjs staging && wrangler pages dev public --config wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src functions test",
    "test": "node --test test/*.test.ts",
    "build": "wrangler pages functions build --outdir .generated/worker",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "configure": "node scripts/configure.mjs",
    "assemble": "node scripts/assemble.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": { "jose": "^6.1.0" },
  "overrides": { "undici": "^7.30.1" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "miniflare": "5.20261019.2-beta",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "wrangler": "^4.152.0"
  }
}
